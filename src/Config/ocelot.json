{
  "Routes": [
    {
      "DownstreamPathTemplate": "/offer/api/offers",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "#{Domain_Ocelot_config_offer}#",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/gtw/offer/api/offers",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "AAD", "GIGYA MyPulse v2" ]
      }
    },
    {
      "DownstreamPathTemplate": "/offer/api/offers/{offerId}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "#{Domain_Ocelot_config_offer}#",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/gtw/offer/api/offers/{offerId}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "AAD", "GIGYA MyPulse v2" ]
      }
    },
    {
      "DownstreamPathTemplate": "/account/api/roles/signatory/{accountId}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "#{Domain_Ocelot_config_account}#",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/gtw/account/api/roles/signatory/{accountId}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "AAD", "GIGYA MyPulse v2" ]
      }
    },
    {
      "DownstreamPathTemplate": "/account/api/accounts/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "#{Domain_Ocelot_config_account}#",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/gtw/account/api/accounts/{everything}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "AAD", "GIGYA MyPulse v2" ]
      }
    },
    {
      "DownstreamPathTemplate": "/account/api/accounts/{accountId}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "#{Domain_Ocelot_config_account}#",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/gtw/account/api/accounts/{accountId}",
      "UpstreamHttpMethod": [
        "PATCH"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "AAD", "GIGYA MyPulse v2" ]
      }
    },
    {
      "DownstreamPathTemplate": "/contact/api/contacts/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "#{Domain_Ocelot_config_contact}#",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/gtw/contact/api/contacts/{everything}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "AAD", "GIGYA MyPulse v2" ]
      }
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "Account",
      "TransformByOcelotConfig": false,
      "Config": [
        {
          "Name": "Pulse.Back.Account",
          "Version": "v1",
          "Url": "https://#{Domain_Ocelot_config_account}#/account/api/v1/api.json"
        }
      ]
    },
    {
      "Key": "Offer",
      "TransformByOcelotConfig": false,
      "Config": [
        {
          "Name": "Pulse.Back.Offer",
          "Version": "v1",
          "Url": "https://#{Domain_Ocelot_config_offer}#/offer/api/v1/api.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://#{Ocelot_config_BaseUrl}#/gateway/api"
  }
}